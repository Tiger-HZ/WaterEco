 "relations": {
  "issued_by": {"zh": "由…发布", "from": "regulation", "to": "org", "note": "发文机关"},
  "based_on": {"zh": "制定依据", "from": "regulation", "to": "regulation", "note": "正文出现「依据《X》」或上级法"},
  "implements": {"zh": "贯彻落实", "from": "regulation", "to": "regulation|action", "note": "为落实X而制定"},
  "revises": {"zh": "修订/替代", "from": "regulation", "to": "regulation", "note": "标题含修订/替代/废止关系"},
  "applies_to": {"zh": "适用范围", "from": "regulation", "to": "waterbody|region", "note": "适用水体或地域"},
  "targets": {"zh": "管控对象", "from": "regulation|tech|action", "to": "pollutant|facility", "note": "针对的污染物或设施"},
  "addresses": {"zh": "解决问题", "from": "regulation|tech|action", "to": "issue", "note": "针对的问题（黑臭、返黑返臭、溢流、水华等）"},
  "monitors": {"zh": "监测/评价", "from": "tech|facility", "to": "indicator|pollutant", "note": "监测或评价的指标"},
  "applied_in": {"zh": "落地实践", "from": "tech|action", "to": "region", "note": "在某地实践"},
  "co_occurs": {"zh": "同文共现", "from": "any", "to": "any", "note": "同一篇文件中共同出现，权重按类型组合下调，仅作弱关联"}
 },

