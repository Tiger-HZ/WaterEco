 "build_rules": {
  "node_id": "类型前缀 + 规范名 sha1 前 10 位，如 wb_1a2b3c4d5e",
  "edge_weight": "同一记录内两实体共同出现 +1；显式关系（依据/发布）权重 3；跨记录共现权重 1（仅保留 >=2 的）",
  "prune": "度数为 1 且仅为 co_occurs 的节点不进入主图（降噪）",
  "output": "kb/graph.json：{nodes:[{id,name,type,cnt}], edges:[{s,t,rel,w}], stats:{}}"
 },

 "analytics": {
  "policy_lineage": "以 regulation 节点为轴，回溯 based_on / revises 链，形成政策沿革",
  "basin_view": "以 waterbody 为轴，聚合 applies_to 的法规、applied_in 的技术与行动 —— 支撑流域治理全景",
  "gap_check": "某业务域(topic)下 regulation 节点为空 -> 提示「该领域政策依据缺失，需补充采集」",
  "hot_issues": "按 issues 节点的度数与时间分布，识别当前治理热点"
 }
