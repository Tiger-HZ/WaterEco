                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Effects of different fertilization methods on <i>Lolium multiflorum</i> Lam. growth and bacterial community in waste slag</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Research Article</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2023-04-10">10 April 2023</time>
                        </li>
                    </ul>
