    <meta name="journal_id" content="41893"/>
    <meta name="dc.title" content="Dual use of solar power plants as biocrust nurseries for large-scale arid soil restoration"/>
    <meta name="dc.source" content="Nature Sustainability 2023 6:8"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Nature Publishing Group"/>
