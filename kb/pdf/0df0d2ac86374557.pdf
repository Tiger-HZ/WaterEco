<!-- Custom css from theme panel -->
<style type="text/css" media="screen">
/* custom css theme panel */
/* Table layout */
.td-post-content table {
    width: 100% !important;
    table-layout: auto !important;
    border-collapse: collapse;
}

/* Table cells */
.td-post-content table td,
.td-post-content table th {
    white-space: normal !important;

    /* Prevent breaking normal words */
    word-break: normal !important;
    overflow-wrap: break-word !important;

    /* Better wrapping */
    hyphens: auto;

    vertical-align: top;
}

/* Remove responsive fade overlay */
.td-responsive-table-wrap::after {
    display: none !important;
}



/* FORCE TEXT WRAPPING */
/* This stops the table from stretching and forces text to wrap normally */
.td-post-content table, 
.td-responsive-table-wrap table {
    table-layout: auto !important; /* Allows columns to adjust to content */
    width: 100% !important;
}


.heading {
    font-family: 'Open Sans' !important;
    font-style: normal !important;
    font-weight: 600 !important;
    background-color: #f2f2f2 !important;
    padding-top: 25px !important;
    padding-bottom: 25px !important;
    padding-left: 17px !important;
    font-size: 19px !important;
    color: #003d79 !important;
    text-transform: uppercase !important;
    margin-left: 0px !important;
    
    /* This closes the white gap - adjust -10 to -30 if needed */
    margin-top: -10px !important; 
}

/* FIX FOR THE ROW CONTAINER ADDED BY THE UPDATE */
#res.vc_row_inner, 
.mob.vc_row_inner,
#res.vc_row,
.mob.vc_row {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

@media only screen and (min-width: 992px) {
    
.footer-c {
    margin-left: 350px;
    
}
    
}

/*@media only screen and (min-width: 992px) {
    
  .td-pb-row [class*="td-pb-span"] {
   
   margin-top: -20px;   
  }
}*/



.td-header-style-1 .td-header-sp-logo img {
    max-height: 117px !important;
}

.td-header-style-1 .td-header-sp-logo {
   
    height: 118px !important;
   
}

.uplp-post-title {
    font-size: 18px !important;
    line-height: 26px !important;
    font-weight: 600 !important;
}


