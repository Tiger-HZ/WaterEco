    <script type="text/javascript"  src="/js/htmlinsert.js?timestamp=202604231520390886"></script>
<script type="text/javascript" >

    window.onload = function () {
        var device = tools.currDevice()
        // ipad mobile 和 ipad true
        // iphone mobile 和 iphone true
        // android mobile 和 android true
        if (device.isMobile && (device.iphone || device.android)) {
            return false;
        }
        tools.replaceNode()
    }
</script>


<script src="/js/crossmark_widget.js" type="text/javascript"></script>


<script  type="text/javascript">
        (function () {

            function runHighlight() {
                if (typeof jQuery === 'undefined') return;

                var searchPagePath = "/journal/articles";
                var referrer = document.referrer;

                if (!referrer || referrer.indexOf(searchPagePath) === -1) return;

                try {
                    var refUrl = new URL(referrer);
                    var code = refUrl.searchParams.get("searchcode");

                    if (code) {
                        var keyword = decodeURIComponent(code.replace(/\+/g, ' ')).trim();
                        if (keyword) {
                            highlightText(keyword);
                        }
                    }

                } catch (e) { }
            }

            // 终极高亮函数
            function highlightText(term) {
                var $ = jQuery;
                var $container = $('.articles_main');
                if ($container.length === 0) return;

                function escapeReg(str) {
                    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                }

                var patterns = [];
                // 1️整体短语
                patterns.push(term);
                // 2️空格拆词 + 过滤停用词
                var stopWords = [
                    "in", "on", "at", "of", "to", "for", "and", "or", "the", "a", "an",
                    "with", "by", "from", "as", "is", "are", "was", "were"
                ];
                var words = term
                    .split(/\s+/)
                    .filter(Boolean)
                    .filter(function (w) {
                        // 如果包含中文，直接保留
                        if (/[\u4e00-\u9fa5]/.test(w)) {
                            return true;
                        }
                        // 英文才做长度和停用词过滤
                        if (w.length <= 2) return false;
                        if (stopWords.indexOf(w.toLowerCase()) !== -1) return false;
                        return true;
                    });
                // 直接concat过滤后的words（移除多余的patterns.push(term)）
                patterns = patterns.concat(words);
                // 3️中文拆单字（原代码已注释，保持不变）
                // words.forEach(function (w) {
                //   if (/[\u4e00-\u9fa5]/.test(w)) {
                //     w.split('').forEach(function (ch) {
                //       patterns.push(ch);
                //     });
                //   }
                // });

                // 4️去重 + 转义 + 添加词边界（核心修改）
                var tempMap = {};
                var newPatterns = [];
                patterns.forEach(function (origP) {
                    var p = escapeReg(origP);
                    if (!tempMap[p]) {
                        tempMap[p] = true;
                        var bounded = p;  // 默认无边界
                        // 如果不含中文，添加词边界 \b ... \b（防止子串匹配）
                        if (!/[\u4e00-\u9fa5]/.test(origP)) {
                            bounded = '\\b' + p + '\\b';
                        }
                        newPatterns.push(bounded);
                    }
                });
                patterns = newPatterns;

                if (patterns.length === 0) return;

                // 5️长词优先（排序基于带边界的patterns长度，相对顺序不变）
                patterns.sort(function (a, b) {
                    return b.length - a.length;
                });

                // 6️构建正则（保持原样）
                var regex = new RegExp("(" + patterns.join("|") + ")", "gi");

                // 7️扫描并替换（保持原样）
                $container.find("*").addBack().contents().each(function () {
                    if (this.nodeType === 3) {
                        if ($(this).parent().is("script,style")) return;
                        var text = this.nodeValue;
                        if (text.search(regex) !== -1) {
                            $(this).replaceWith(
                                text.replace(
                                    regex,
                                    '<span style="color:red;font-weight:bold;">$1</span>'
                                )
                            );
                        }
                    }
                });
            }

            if (window.jQuery) {

                var timer = setInterval(function () {

                    if ($('.articles_main').length > 0) {
                        clearInterval(timer);
                        runHighlight();
                    }

                }, 300);

            }


        })();
</script>




