        <div class="app-masthead-save-research__hide-on-lg">
            <a class="app-masthead-save-research__action-link" rel="nofollow" href="/saved-research" data-track="click_saved_research" data-track-context="masthead" data-test="view-saved-research-link">
                <span>View saved research</span><svg class="app-masthead-save-research__icon app-masthead-save-research__icon--small" width="16" height="16" aria-hidden="true" focusable="false">
