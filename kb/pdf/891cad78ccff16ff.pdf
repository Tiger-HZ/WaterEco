            <article lang="en">
                
                <div class="c-article-header">
                    <header>
                        <ul class="c-article-identifiers" data-test="article-identifier">
                            
        <li class="c-article-identifiers__item" data-test="article-category">Perspective</li>
    
    

                            <li class="c-article-identifiers__item">Published: <time datetime="2026-10-02">02 October 2026</time></li>
                        </ul>

                        <h1 class="c-article-title" data-test="article-title" data-article-title="">Calibrating antimicrobial resistance influent and effluent signals in wastewater systems</h1>
                        <ul class="c-article-author-list c-article-author-list--short" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="1_4" data-track-context="researcher popup with no profile" href="#auth-_ndrea-Naziri-Aff1-Aff2" data-author-popup="auth-_ndrea-Naziri-Aff1-Aff2" data-track-label="Αndrea Naziri" data-author-search="Naziri, Αndrea">Αndrea Naziri</a><span class="u-js-hide"> 
            <a class="js-orcid" href="https://orcid.org/0000-0002-6090-308X"><span class="u-visually-hidden">ORCID: </span>orcid.org/0000-0002-6090-308X</a></span><sup class="u-js-hide"><a href="#Aff1">1</a>,<a href="#Aff2">2</a></sup>, </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="2_4" data-track-context="researcher popup with no profile" href="#auth-Stelios-Chatzimichail-Aff1" data-author-popup="auth-Stelios-Chatzimichail-Aff1" data-track-label="Stelios Chatzimichail" data-author-search="Chatzimichail, Stelios">Stelios Chatzimichail</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="3_4" data-track-context="researcher popup with no profile" href="#auth-Popi-Karaolia-Aff1" data-author-popup="auth-Popi-Karaolia-Aff1" data-track-label="Popi Karaolia" data-author-search="Karaolia, Popi">Popi Karaolia</a><span class="u-js-hide"> 
            <a class="js-orcid" href="https://orcid.org/0000-0003-0867-8177"><span class="u-visually-hidden">ORCID: </span>orcid.org/0000-0003-0867-8177</a></span><sup class="u-js-hide"><a href="#Aff1">1</a></sup> &amp; </li><li class="c-article-author-list__show-more" aria-label="Show all 4 authors for this article" title="Show all 4 authors for this article">…</li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="4_4" data-track-context="researcher popup with no profile" href="#auth-Despo-Fatta_Kassinos-Aff1-Aff2" data-author-popup="auth-Despo-Fatta_Kassinos-Aff1-Aff2" data-track-label="Despo Fatta-Kassinos" data-author-search="Fatta-Kassinos, Despo" data-corresp-id="c1">Despo Fatta-Kassinos<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><span class="u-js-hide"> 
            <a class="js-orcid" href="https://orcid.org/0000-0003-1173-0941"><span class="u-visually-hidden">ORCID: </span>orcid.org/0000-0003-1173-0941</a></span><sup class="u-js-hide"><a href="#Aff1">1</a>,<a href="#Aff2">2</a></sup> </li></ul><button aria-expanded="false" class="c-article-author-list__button"><svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-chevron-down-medium"></use></svg><span>Show authors</span></button>

                        

                        <p class="c-article-info-details" data-container-section="info">
                            <a data-test="journal-link" href="/natwater" data-track="click" data-track-action="journal homepage" data-track-category="article body" data-track-label="link"><i>Nature Water</i></a>
                             (<span data-test="article-publication-year">2026</span>) <a href="#citeas" class="c-article-info-details__cite-as u-hide-print" data-track="click" data-track-action="cite this article" data-track-label="link">Cite this article</a>
                        </p>
                        
                            <div class="u-mt-8 u-mb-16">
                                
    <div class="app-masthead-save-research">
        
            <a class="app-masthead-save-research__action-link" rel="nofollow" href="/articles/s44221-026-00701-1/save-research?_csrf=CK8lBAshIWA8PRg6qX0n2xIGWBIOggV6" data-track="form_saved_research" data-track-context="saved on article page" data-track-value="save" id="save_article">
