                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Anxiety as a Moderator Between Autistic/ADHD Traits and Quality of Life in Autistic Children and Adolescents</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Original Article</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-09-16">16 September 2026</time>
                        </li>
                    </ul>
