                                        <svg width="24" height="24" focusable="false" role="img" aria-hidden="true" class="c-status-message__icon">
                                            <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-info-filled-medium"></use>
                                        </svg>
                                        
