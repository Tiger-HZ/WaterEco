-name" data-track="click_view_author" data-track-action="open author" data-track-index="8_8" data-track-context="researcher popup with no profile" href="#auth-Abdul_Hadi-Kaipakasseri-Aff1" data-author-popup="auth-Abdul_Hadi-Kaipakasseri-Aff1" data-track-label="Abdul Hadi Kaipakasseri" data-author-search="Kaipakasseri, Abdul Hadi">Abdul Hadi Kaipakasseri</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup> </li></ul><button aria-expanded="false" class="c-article-author-list__button"><svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-chevron-down-medium"></use></svg><span>Show authors</span></button>
                        
    


