    <meta name="dc.title" content="The planktonic food web structure of a temperate zone estuary, and its alteration due to eutrophication"/>
    <meta name="dc.source" content="Hydrobiologia 2002 475:1"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Springer"/>
