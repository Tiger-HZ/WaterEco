    <meta name="dc.title" content="Visually determined stream mesohabitats influence benthic macroinvertebrate assessments in headwater streams"/>
    <meta name="dc.source" content="Environmental Monitoring and Assessment 2014 186:9"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Springer"/>
