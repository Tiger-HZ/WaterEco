                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Water quality assessment using sediment analysis and Sentinel-3-derived bio-optical variables in Lagoa da Conceição, Brazil</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Research</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-10-02">02 October 2026</time>
                        </li>
                    </ul>
