                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Drying Characteristics and Quality Evaluation of Hawthorn Using Ultrasonic Integrated Hot Air Drying Technology</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">RESEARCH</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-09-16">16 September 2026</time>
                        </li>
                    </ul>
