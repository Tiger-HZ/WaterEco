                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Characterization and Source Identification of Particulate Matter Over Srinagar (Garhwal) in Central Himalayan Region</h1>

                    <ul class="c-article-identifiers">
                        
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-09-11">11 September 2026</time>
                        </li>
                    </ul>
