                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Assessment of the current state of the coastal recreational zone of Sakhalin Island (case study of Lososey Bay): initial monitoring stage</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Research Article</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-09-09">09 September 2026</time>
                        </li>
                    </ul>
