                    <h1 class="c-article-title" data-test="article-title" data-article-title="">A new ecological index for assessing benthic invertebrate assemblages in tropical coral reef ecosystems</h1>

                    <ul class="c-article-identifiers">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Research Article</li>
    
    

                        <li class="c-article-identifiers__item">
                            Published: <time datetime="2026-05-02">02 May 2026</time>
                        </li>
                    </ul>
