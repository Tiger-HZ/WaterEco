    <meta name="dc.title" content="A new ecological index for assessing benthic invertebrate assemblages in tropical coral reef ecosystems"/>
    <meta name="dc.source" content="Aquatic Sciences 2026 88:3"/>
    <meta name="dc.format" content="text/html"/>
