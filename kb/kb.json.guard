  "origin_url": "https://www.mee.gov.cn/xxgk2018/xxgk/xxgk01/202506/W020250627362332936994.pdf",
  "origin_title": "有毒有害水污染物名录（第二批）",
  "origin_source": "www.mee.gov.cn（国家级官方）",
  "origin_domain": "www.mee.gov.cn",
