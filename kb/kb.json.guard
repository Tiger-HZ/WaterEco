  "origin_checked_at": "2026-09-22T03:22:00",
  "origin_status": "原文已核",
  "origin_url": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/shjbh/xgbzh/201705/W020170511332490849000.pdf",
  "origin_title": "排污单位自行监测技术指南 总则(HJ 819-2017)",
  "origin_source": "www.mee.gov.cn（国家级官方）",
