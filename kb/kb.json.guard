 {
  "title": "Benchmarking nutritional water productivity of twenty vegetables - A review",
  "url": "https://doi.org/10.1016/j.agwat.2019.05.008",
  "source": "Agricultural Water Management",
  "journal": "Agricultural Water Management",
  "journal_tier": "top",
