 {
  "title": "Effectiveness of artificial floods for benthic community recovery after sediment flushing from a dam",
  "url": "https://doi.org/10.1007/s10661-019-7232-7",
  "source": "Environmental Monitoring and Assessment",
  "journal": "Environmental Monitoring and Assessment",
  "journal_tier": "top",
  "date": "2019-01-19",
  "category": "literature",
  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Effectiveness of artificial floods for benthic community recovery after sediment flushing from a dam",
  "tags": [],
  "content_fetched": true,
  "pdf": "kb/pdf/dcba5c2c3c727cb1.pdf",
  "cid": "dcba5c2c3c727cb1",
  "importance": 5.59,
  "added_at": "2026-10-10",
  "_ev": "ti:e605f6aa1748bf49",
  "quality_src": "B",
  "water_rel": 0.3,
  "kg_terms": [],
  "content_type": "研究文献",
