 {
  "title": "Elevated levels of glyoxal and methylglyoxal at a remote mountain site in southern China: Prompt in-situ formation combined with strong regional transport",
  "url": "https://doi.org/10.1016/j.scitotenv.2019.04.020",
  "source": "Science of The Total Environment",
  "journal": "Science of The Total Environment",
  "journal_tier": "top",
  "date": "2019-07-01",
  "category": "literature",
  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Elevated levels of glyoxal and methylglyoxal at a remote mountain site in southern China: Prompt in-situ formation combined with strong regional transport",
  "tags": [],
  "content_fetched": true,
  "pdf": null,
  "cid": "6d796040176ea51c",
  "importance": 5.59,
  "added_at": "2026-10-09",
  "_ev": "ti:4d103dcb09bf5e8a",
  "quality_src": "B",
  "water_rel": 0.3,
  "kg_terms": [],
  "content_type": "研究文献",
