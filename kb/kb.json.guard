 {
  "title": "关于发布《酒类制造业水污染物排放标准》等三项国家水污染物排放标准的公告",
  "url": "https://www.mee.gov.cn/xxgk2018/xxgk/xxgk01/202512/t20251205_1137211.html",
  "source": "生态环境部",
  "date": "",
  "category": "management",
  "content_type": "政策文件",
  "department": "生态环境",
  "region": "全国",
  "quality": "A",
