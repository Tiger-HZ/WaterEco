 {
  "title": "4.29亿！碧水源预中标",
  "url": "https://www.h2o-china.com/news/364852.html",
  "source": "中国水网（行业媒体与案例",
  "date": "",
  "category": "policy",
  "content_type": "政策文件",
  "department": "其他",
  "region": "全国",
  "quality": "C",
  "quality_src": "B",
