 {
  "title": "国务院办公厅关于批准盘锦市城市总体规划的通知",
  "url": "http://www.gov.cn/zhengce/zhengceku/2017-10/10/content_5230802.htm",
  "source": "国务院办公厅",
  "date": "2017-10-10",
  "category": "policy",
  "department": "其他",
  "region": "全国",
  "quality": "B",
