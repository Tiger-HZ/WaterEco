  "source": "Science of The Total Environment",
  "journal": "Science of The Total Environment",
  "journal_tier": "top",
  "date": "2019-07-01",
  "category": "literature",
  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Removal efficiency and mass balance of polycyclic aromatic hydrocarbons, phthalates, ethoxylated alkylphenols and alkylphenols in a mixed textile-domestic wastewater treatment plant",
  "tags": [],
  "content_fetched": true,
  "pdf": null,
  "cid": "2e0f72fe1140688a",
  "importance": 5.59,
  "added_at": "2026-10-09",
  "_ev": "ti:216bbc3d6735b574",
  "quality_src": "B",
  "water_rel": 0.3,
  "kg_terms": [],
  "content_type": "研究文献",
