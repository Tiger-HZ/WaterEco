 {
  "title": "国务院办公厅关于印发2019年政务公开工作要点的通知",
  "url": "http://www.gov.cn/zhengce/zhengceku/2019-04/29/content_5387400.htm",
  "source": "国务院办公厅",
  "date": "2019-04-29",
  "category": "policy",
  "department": "其他",
  "region": "全国",
  "quality": "B",
  "summary": "持续开展大气污染治理攻坚、加快治理黑臭水体、防治农业面源污染、推进重点流域和近岸海域综合整治、加强固体废弃物和城市垃圾分类处置等方面，进一步做好生态环境信息公开。 （二）深化“放管服”改革信息公开。",
  "tags": [
   "水生态环境",
   "国家政策",
   "国办发〔2019〕14号",
   "国务院办公厅"
  ],
  "content_fetched": true,
  "added_at": "2019-04-29",
  "_ev": "ev:国办发〔2019〕14号",
  "quality_src": "A",
  "water_rel": 0.9,
  "importance": 8.87,
  "kg_terms": [
   "水生态环境",
   "国家政策",
   "国办发〔2019〕14号",
   "国务院办公厅",
   "面源污染",
