 {
  "title": "《水污染防治行动计划》（“水十条”）",
  "url": "https://www.gov.cn/govweb/gongbao/content/2015/content_2853604.htm",
  "source": "国务院",
  "date": "2015-04-02",
  "category": "policy",
  "content_type": "政策文件",
  "department": "生态环境",
  "region": "全国",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "以改善水环境质量为核心的十年期行动计划，提出到2020年七大重点流域水质优良比例达70%以上、地级及以上城市建成区黑臭水体控制在10%以内、集中式饮用水水源水质达Ⅲ类比例高于93%；部署全面控制污染物排放、节约保护水资源、严格环境执法监管等十大措施，是水生态环境治理的基础性文件。",
  "tags": [
   "水十条",
   "黑臭水体",
   "饮用水水源",
   "总量控制"
  ],
  "added_at": "2026-09-18",
  "content_fetched": true,
  "status": "有效",
  "water_rel": 1.0,
  "importance": 5.8,
  "kg_terms": [
   "水十条",
   "黑臭水体",
   "饮用水水源",
   "总量控制",
   "水污染防治",
   "水生态环境",
   "重点流域",
   "水环境",
   "水生态",
   "水资源",
   "流域"
  ],
  "note": "国务院公报版全文。",
  "cid": "cab68183a16aca08",
