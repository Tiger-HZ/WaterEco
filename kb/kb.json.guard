 {
  "title": "Hydrodynamic cavitation using vortex diode: An efficient approach for elimination of pathogenic bacteria from water",
  "url": "https://doi.org/10.1016/j.jenvman.2019.04.057",
  "source": "Journal of Environmental Management",
  "journal": "Journal of Environmental Management",
  "journal_tier": "top",
