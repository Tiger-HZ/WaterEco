  "origin_url": "https://www.gov.cn/zhengce/zhengceku/202607/content_7075214.htm",
  "origin_title": "国务院关于印发《国民健康“十五五”规划》的通知",
  "origin_source": "国务院（国家级官方）",
  "origin_domain": "www.gov.cn",
  "origin_kind": "正文",
