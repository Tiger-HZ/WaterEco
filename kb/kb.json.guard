 {
  "title": "Aquatics Macroinvertebrate Diversity and Bio-Assessment of the Quality of the Middle Wadi Oum Er-Rbia (Morocco)",
  "url": "https://doi.org/10.12912/27197050/152908",
  "source": "Ecological Engineering &amp; Environmental Technology",
  "journal": "Ecological Engineering &amp; Environmental Technology",
  "journal_tier": "top",
  "date": "2022-11-01",
  "category": "literature",
  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Aquatics Macroinvertebrate Diversity and Bio-Assessment of the Quality of the Middle Wadi Oum Er-Rbia (Morocco)",
  "tags": [],
  "content_fetched": true,
  "pdf": "kb/pdf/8c8f83ba8d8c7a4e.pdf",
  "cid": "8c8f83ba8d8c7a4e",
  "importance": 5.59,
  "added_at": "2026-10-06",
  "_ev": "ti:d8e812ffd35317c0",
