 {
  "title": "国家能源局关于印发《能源领域节能降碳行动计划（2026—2028年）》的通知",
  "url": "https://www.gov.cn/zhengce/zhengceku/202607/content_7074973.htm",
  "source": "国家能源局",
  "date": "2026-07-10",
  "category": "policy",
  "department": "其他",
