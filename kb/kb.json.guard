 {
  "title": "《重点流域水生态环境保护规划（2021—2025年）》",
  "url": "https://www.mee.gov.cn/xxgk2018/xxgk/xxgk03/202112/t20211229_965544.html",
  "source": "生态环境部等5部门",
  "date": "2021-12-31",
  "category": "policy",
  "content_type": "国家规划",
  "department": "生态环境",
  "region": "全国",
