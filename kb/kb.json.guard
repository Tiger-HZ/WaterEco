  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Abstract Lake Edku, one of the northern Nile Delta lakes, is a shallow brackish coastal lake subjected to domestic and agricultural effluents via two main drains, El-Khairy and Barsik, in addition to the discharge water of hundreds of fish ",
  "tags": [],
  "content_fetched": true,
  "pdf": "kb/pdf/5a6cb696207e6384.pdf",
  "cid": "5a6cb696207e6384",
  "importance": 5.59,
  "added_at": "2026-10-06",
  "_ev": "ti:c17747d747d9b4b3",
  "quality_src": "A",
