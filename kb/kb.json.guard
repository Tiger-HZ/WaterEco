 {
  "title": "浙江省生态环境保护条例",
  "url": "https://www.zjrd.gov.cn/sylf/fggg/202608/t20260817_264390.shtml",
  "source": "浙江省人民代表大会常务委员会",
  "date": "2022-07-29（通过）／2022-08-01（公布）",
  "category": "policy",
  "content_type": "地方性法规",
  "department": "生态环境",
  "region": "杭州",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "综合性生态保护主干法规，将'三线一单'分区管控、生态产品价值实现、生物多样性保护写入法治。对杭州要求落实分区管控、GEP核算与减污降碳协同。对杭州而言，应将该法规纳入依法治水管水框架，结合钱塘江、苕溪、千岛湖等本地水体特点，强化执法协同与考核问责。",
  "tags": [
   "生态保护",
   "三线一单",
   "GEP",
   "生物多样性"
  ],
