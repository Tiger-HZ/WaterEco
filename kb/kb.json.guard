 {
  "title": "关于印发《入海排污口监督管理办法（试行）》的通知",
  "url": "https://www.gov.cn/zhengce/zhengceku/202410/content_6979379.htm",
  "source": "生态环境部",
  "date": "2024-10-11",
  "category": "policy",
  "department": "生态环境",
