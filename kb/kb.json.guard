  "origin_url": "https://www.gov.cn/zhengce/zhengceku/2022-05/24/content_5692059.htm",
  "origin_title": "国务院办公厅关于印发新污染物治理行动方案的通知",
  "origin_source": "国务院办公厅（国家级官方）",
  "origin_domain": "www.gov.cn",
  "origin_kind": "正文",
