  "title": "Genetic structure and congeneric range overlap among sharpnose sharks (genus <i>Rhizoprionodon</i>) in the Northwest Atlantic Ocean",
  "url": "https://doi.org/10.1139/cjfas-2018-0019",
  "source": "Canadian Journal of Fisheries and Aquatic Sciences",
  "journal": "Canadian Journal of Fisheries and Aquatic Sciences",
  "journal_tier": "top",
  "date": "2019-07-01",
  "category": "literature",
  "department": "其他",
  "region": "国际",
  "quality": "C",
  "summary": "Sharpnose sharks (genus Rhizoprionodon) experience extensive fishing pressure throughout their ranges in the Atlantic Ocean. As such, it is important to understand the degree to which intraspecific populations interact across a spatial grad",
  "tags": [],
  "content_fetched": true,
  "pdf": null,
  "cid": "4c12048e2dd6bc06",
  "importance": 5.59,
  "added_at": "2026-10-10",
  "_ev": "ti:e5498e732b759576",
  "quality_src": "A",
