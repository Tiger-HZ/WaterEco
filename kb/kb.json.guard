 {
  "title": "农田灌溉水质标准",
  "url": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/shjbh/swrwpfbz/202104/t20210420_829431.shtml",
  "source": "生态环境部/国家市场监督管理总局",
  "date": "2021-04-30",
  "category": "standard",
  "content_type": "国家标准",
  "department": "生态环境",
  "region": "全国",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "规定农田灌溉用水的水质要求、监测与分析方法及监督实施。按作物类型分水作、旱作、蔬菜三类控制限值，涵盖基本控制项目与选择性控制项目，防止灌溉水污染土壤、农作物及地下水，替代GB 5084-2005。",
