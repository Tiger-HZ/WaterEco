 {
  "title": "The problem of drinking water access: A review of disinfection technologies with an emphasis on solar treatment methods",
  "url": "https://doi.org/10.1016/j.chemosphere.2018.11.205",
  "source": "Chemosphere",
  "journal": "Chemosphere",
  "journal_tier": "top",
  "date": "2019-03-01",
