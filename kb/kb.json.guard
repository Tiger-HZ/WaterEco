 {
  "title": "《重点流域水生态环境保护规划》",
  "url": "https://www.mee.gov.cn/ywgz/ssthjbh/zdlybhxf/202304/t20230421_1027897.shtml",
  "source": "生态环境部、国家发展改革委、财政部、水利部、国家林草局",
  "date": "2023-04-21",
  "category": "policy",
  "content_type": "国家规划",
  "department": "生态环境",
  "region": "全国",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "经国务院同意，由生态环境部等5部门联合印发。按“河湖统领、三水统筹”思路构建水生态环境保护新格局，设水环境、水资源、水生态三大类11项指标（含3项约束性指标）；到2025年地表水Ⅰ—Ⅲ类比例达85%、劣Ⅴ类基本消除、县级城市建成区黑臭水体基本消除、354条（个）河湖达到生态流量要求。",
  "tags": [
   "三水统筹",
   "流域规划",
   "美丽河湖",
   "生态流量"
  ],
  "added_at": "2026-09-18",
  "content_fetched": true,
  "status": "有效",
  "water_rel": 1.0,
  "importance": 9.3,
  "kg_terms": [
   "三水统筹",
   "流域规划",
   "美丽河湖",
   "生态流量",
   "水生态",
   "水生态环境",
   "生态环境部",
   "流域",
   "国家发展改革委",
   "发展改革委",
