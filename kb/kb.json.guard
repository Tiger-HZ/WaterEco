  "quality": "C",
  "summary": "Using an anti-clogging relative index (CRI) to assess emitters rapidly for drip irrigation systems with multiple low-quality water sources",
  "tags": [],
  "content_fetched": true,
  "pdf": null,
  "cid": "50f5d2fd938d3f6c",
  "importance": 5.59,
  "added_at": "2026-10-09",
