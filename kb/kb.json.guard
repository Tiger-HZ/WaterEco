  "importance": 9.3,
  "kg_terms": [
   "水生态环境",
   "国家政策",
   "国函〔2025〕37号",
   "国务院",
   "黄河流域",
   "流域",
   "自然资源部",
   "水生态"
  ],
  "cid": "9b2c975aa9f71054",
  "images": [
   "kb/img/9b2c975aa9f71054_0.png",
