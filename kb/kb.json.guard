 {
  "title": "依法保护地下水，“渴”不容缓",
  "url": "http://www.gov.cn/zhengce/2021-11/23/content_5652609.htm",
  "source": "中国政府网 · 国务院政策文件库",
  "date": "2021-11-23",
  "category": "policy",
  "department": "其他",
  "region": "全国",
  "quality": "C",
