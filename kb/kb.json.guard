 {
  "title": "国务院办公厅关于印发《落实水资源刚性约束制度考核办法》的通知",
  "url": "https://www.gov.cn/zhengce/zhengceku/202512/content_7053462.htm",
  "source": "国务院办公厅",
  "date": "2025-12-31",
  "category": "policy",
  "department": "水利",
  "region": "全国",
  "quality": "B",
  "summary": "水资源刚性约束制度目标完成情况，推动经济社会发展量水而行、水资源节约集约利用、水资源保护和超载治理、水资源监管等任务措施落实情况，以及责任落实和改革创新情况。考核内容及一级考核指标见附件。 第六条",
  "tags": [
   "水生态环境",
   "国家政策",
   "国办发〔2025〕45号",
   "国务院办公厅"
  ],
  "content_fetched": true,
  "added_at": "2025-12-31",
  "_ev": "ev:国办发〔2025〕45号",
  "quality_src": "A",
  "water_rel": 0.3,
  "importance": 8.69,
  "kg_terms": [
   "水生态环境",
   "国家政策",
   "国办发〔2025〕45号",
   "国务院办公厅",
