 {
  "title": "国务院办公厅关于印发2019年政务公开工作要点的通知 2019年政务公开工作要点",
  "url": "http://www.gov.cn/gongbao/content/2019/content_5389314.htm",
  "source": "中国政府网 · 国务院政策文件库",
  "date": "2019-05-10",
  "category": "policy",
  "department": "其他",
  "region": "全国",
  "quality": "A",
