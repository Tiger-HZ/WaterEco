 {
  "title": "《杭州市生活饮用水源保护条例》",
  "url": "https://wb.flk.npc.gov.cn/dfxfg/PDF/5cccf5158c3c40028e366cd41b3a2a8b.pdf",
  "source": "杭州市人民代表大会常务委员会（浙江省人大常委会批准）",
  "date": "2004-05-28",
  "category": "policy",
