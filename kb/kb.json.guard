 {
  "title": "中华人民共和国水污染防治法",
  "url": "https://www.zj.gov.cn/zjservice/item/detail/lawtext.do?outLawId=0f6f1693-ce4b-408d-a3f8-07ab189aa503",
  "source": "浙江省人民政府·法律法规库",
