  ],
  "cid": "39aecc4cca620892",
  "pdf": "kb/pdf/39aecc4cca620892.pdf",
  "note": "已抓取 PDF 原文：kb/pdf/39aecc4cca620892.pdf",
  "content_note": "内容校验不合格（too_short:415），已标记重取",
