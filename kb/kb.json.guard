 {
  "title": "智慧治水新样本：首创环保中标宁夏全区污水处理服务",
  "url": "https://www.h2o-china.com/news/364751.html",
  "source": "中国水网（行业媒体与案例",
  "date": "",
  "category": "management",
  "content_type": "政策文件",
  "department": "生态环境",
