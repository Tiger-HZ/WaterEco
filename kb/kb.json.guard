  "quality_src": "A",
  "water_rel": 0.65,
  "importance": 9.5,
  "kg_terms": [
   "水生态环境",
   "国家政策",
   "生态补偿",
   "水生态"
  ],
  "cid": "dbe09aadeefa9421",
