 {
  "title": "中华人民共和国水土保持法",
  "url": "https://slqjd.mwr.gov.cn/upload/2020/03-15/00-14-460731-1575309629.pdf",
  "source": "全国人民代表大会常务委员会",
  "date": "2010-12-25",
  "category": "policy",
  "content_type": "法律",
  "department": "水利",
  "region": "全国",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "为预防和治理水土流失、保护和合理利用水土资源、减轻水旱风沙灾害、改善生态环境而制定的法律，规定水土保持规划、预防、治理、监测监督及法律责任。2010年修订后2011年施行，现行有效，是水生态保护的重要法律依据。",
  "tags": [
   "水土保持",
   "水土流失",
   "生态修复"
  ],
