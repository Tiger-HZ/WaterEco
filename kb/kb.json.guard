 {
  "title": "中华人民共和国环境影响评价法",
  "url": "https://www.gov.cn/gongbao/content/2002/content_61822.htm",
  "source": "全国人民代表大会常务委员会",
  "date": "2002-10-28",
  "category": "policy",
  "content_type": "法律",
  "department": "生态环境",
  "region": "全国",
  "quality": "A",
  "quality_src": "A",
  "visibility": "官方权威",
  "summary": "为实施可持续发展战略、预防因规划和建设项目实施后对环境造成不良影响、促进经济社会和环境保护协调发展而制定的法律，确立规划与建设项目环评、公众参与、跟踪评价及法律责任。2016、2018年修正，2026年8月15日《生态环境法典》施行后被吸收并同步废止。",
  "tags": [
   "环评",
   "规划环评",
   "公众参与"
  ],
  "added_at": "2026-09-18",
  "content_fetched": true,
  "status": "已废止",
  "water_rel": 0.3,
  "importance": 10.0,
  "kg_terms": [
   "环评",
   "规划环评",
