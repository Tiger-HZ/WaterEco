 {
  "title": "财政部部长：积极的财政政策要大力提质增效",
  "url": "http://www.gov.cn/zhengce/2020-02/16/content_5479626.htm",
  "source": "中国政府网 · 国务院政策文件库",
  "date": "2020-02-16",
  "category": "basin_eng",
  "department": "其他",
  "region": "全国",
  "quality": "C",
